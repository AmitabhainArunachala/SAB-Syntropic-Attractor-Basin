{
  "$defs": {
    "AuthorizedDispositionAuthorityV1": {
      "additionalProperties": false,
      "properties": {
        "allowed_effects": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Effects",
          "type": "array"
        },
        "artifact_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "authority_refs": {
          "items": {
            "type": "string"
          },
          "title": "Authority Refs",
          "type": "array"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "evaluated_state_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evaluated State Hash",
          "type": "string"
        },
        "evaluation_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evaluation Id",
          "type": "string"
        },
        "forbidden_effects": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Forbidden Effects",
          "type": "array"
        },
        "live_eligible": {
          "title": "Live Eligible",
          "type": "boolean"
        },
        "policy_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "result": {
          "const": "Authorized",
          "default": "Authorized",
          "title": "Result",
          "type": "string"
        },
        "schema": {
          "const": "sab.disposition_authority.v1",
          "default": "sab.disposition_authority.v1",
          "title": "Schema",
          "type": "string"
        },
        "scope": {
          "enum": [
            "Copy",
            "Live"
          ],
          "title": "Scope",
          "type": "string"
        },
        "standing_effect": {
          "const": "none",
          "default": "none",
          "title": "Standing Effect",
          "type": "string"
        }
      },
      "required": [
        "evaluation_id",
        "artifact_id",
        "scope",
        "authority_refs",
        "policy_sha256",
        "content_sha256",
        "evaluated_state_hash",
        "reason_codes",
        "live_eligible"
      ],
      "title": "AuthorizedDispositionAuthorityV1",
      "type": "object"
    }
  },
  "$id": "https://sab.local/schemas/sab.effective_verdict.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applied_at": {
      "format": "date-time",
      "title": "Applied At",
      "type": "string"
    },
    "authority": {
      "$ref": "#/$defs/AuthorizedDispositionAuthorityV1"
    },
    "effective_verdict_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Effective Verdict Id",
      "type": "string"
    },
    "effects": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Effects",
      "type": "array"
    },
    "evidence_provenance": {
      "const": "real_external_models",
      "default": "real_external_models",
      "title": "Evidence Provenance",
      "type": "string"
    },
    "fixture_derived": {
      "const": false,
      "default": false,
      "title": "Fixture Derived",
      "type": "boolean"
    },
    "schema": {
      "const": "sab.effective_verdict.v1",
      "default": "sab.effective_verdict.v1",
      "title": "Schema",
      "type": "string"
    },
    "scope": {
      "const": "Live",
      "default": "Live",
      "title": "Scope",
      "type": "string"
    },
    "standing_effect": {
      "const": "none",
      "default": "none",
      "title": "Standing Effect",
      "type": "string"
    },
    "verdict_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Verdict Id",
      "type": "string"
    },
    "verdict_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Verdict Sha256",
      "type": "string"
    }
  },
  "required": [
    "effective_verdict_id",
    "verdict_id",
    "verdict_sha256",
    "authority",
    "effects",
    "applied_at"
  ],
  "title": "EffectiveVerdictV1",
  "type": "object"
}
